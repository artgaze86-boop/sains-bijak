# Pangkalan data PostgreSQL (wajib untuk production)
# Lokal dengan Docker: docker compose up -d
DATABASE_URL="postgresql://sainsbijak:sainsbijak123@localhost:5432/sainsbijak?schema=public"

# Production (Neon/Supabase/Render) — contoh:
# DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/sainsbijak?sslmode=require"

# JWT
JWT_SECRET="tukar-rahsia-jwt-panjang-dan-random-di-sini"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS (comma-separated origins, atau * untuk mobile app)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Seed data pada startup (set true sekali sahaja semasa deploy pertama)
RUN_SEED=false